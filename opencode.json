{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx.cmd", "-y", "@playwright/mcp@latest", "--browser", "chrome", "--isolated"],
      "enabled": true
    },
    "playwright-mobile": {
      "type": "local",
      "command": [
        "npx.cmd",
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chrome",
        "--device",
        "iPhone 15",
        "--isolated"
      ],
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "npm run dev*": "allow",
      "npm run preview*": "allow",
      "npx.cmd *": "allow"
    }
  }
}
